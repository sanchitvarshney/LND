# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# --- Database driver ---
# file   = zero-setup JSON store (default, no DB needed)
# prisma = real database via Prisma (run `npm run db:setup` first)
DB_DRIVER="file"

# Used only when DB_DRIVER=prisma.
# SQLite (local dev, no server):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) — set provider="postgresql" in prisma/schema.prisma, then:
# DATABASE_URL="postgresql://user:password@localhost:5432/learnguard?schema=public"

# --- AI features (optional, FREE only) ---
# These power the learning-assistant chat, AI question drafts, failure review
# plans and the manager digest. They are OPTIONAL: leave AI_API_KEY empty and
# the whole app still works — the AI extras just stay hidden. No key = no cost.
#
# Only FREE providers are supported (OpenAI-compatible). Pick ONE:
#
#   Groq (default, FREE — get a key at https://console.groq.com, no card):
#     AI_API_KEY="gsk_..."
#     AI_BASE_URL="https://api.groq.com/openai/v1"
#     AI_MODEL="llama-3.3-70b-versatile"
#
#   Google Gemini (FREE tier — get a key at https://aistudio.google.com):
#     AI_API_KEY="AIza..."
#     AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#     AI_MODEL="gemini-2.0-flash"
#
# Defaults below target Groq's free tier — just paste a free key into AI_API_KEY.
AI_API_KEY="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"
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"

# --- Email (optional) ---
# Enables welcome / assignment / due-soon / overdue / recertification emails.
# Leave SMTP_HOST empty to disable (the app still works; in-app notifications remain).
# Use your company mail server or any SMTP provider (free tiers: Brevo, Gmail app password, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Learning & Development Portal <no-reply@mscorpres.in>"
APP_PUBLIC_URL="https://lnd-orpin.vercel.app"   # used for links/buttons inside emails
